<%
  healthy_count = local_assigns.fetch(:healthy_count) { (@ticks || []).map(&:exchange).uniq.size }
  total_count   = Aggregator::Sources::REGISTRY.size
  lg_price      = local_assigns.fetch(:last_good_price) { @last_good_price }
  lg_age        = local_assigns.fetch(:last_good_age)   { @last_good_age }
%>
<div class="error">
  Insufficient sources — only <%= healthy_count %> of <%= total_count %> healthy.
</div>
<% if lg_price %>
  <p class="hint last-good">last good price was $<%= format_price(lg_price) %>, <%= format_age(lg_age) %> ago</p>
<% end %>
