# Copy this file to `.env` before `docker compose up`:
#
#     cp .env.example .env
#
# These are dev-only credentials for the throwaway Postgres + Redis containers.
# `.env` is gitignored.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpw
POSTGRES_DB=multi_exchange_price_aggregator_development

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=devpw

REDIS_URL=redis://redis:6379/0
